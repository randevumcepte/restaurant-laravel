# ==== ResteOS AI Santral kopru — ornek ayar (kopyala: cp .env.example .env) ====

# --- Asterisk ARI (Asterisk 16/17) ---
# /etc/asterisk/ari.conf ve http.conf ile eslesmeli (README'ye bak)
ARI_URL=http://127.0.0.1:8088
ARI_USER=santral
ARI_PASS=degistir-bu-sifreyi
# Dialplan'de Stasis(...) ile cagrilan uygulama adi
ARI_APP=santral-ai

# --- Bu koprunun RTP dinledigi yerel adres (Asterisk ile AYNI sunucu) ---
# externalMedia bu host:port'a ham RTP gonderir; biz de TTS'i buradan geri yollariz
RTP_HOST=127.0.0.1
# Cagri basina bu taban porttan itibaren cift port secilir (RTP standardi)
RTP_PORT_BASE=40000
RTP_PORT_COUNT=100

# Telefon sesi darbant: ulaw/8kHz native (yeniden orneklemesiz)
# Secenek: ulaw | slin16   (ulaw = telefon standardi, onerilen)
MEDIA_FORMAT=ulaw

# --- Laravel beyin (SantralAsistan) ---
LARAVEL_BASE_URL=https://restaurant.webfirmam.com.tr
# Coklu sube varsa hangi sube_id ile calisilacak (dialplan'den de gelebilir)
DEFAULT_SUBE_ID=1
# Kopru -> Laravel istekleri icin paylasilan sir (uc tarafinda dogrulanir; opsiyonel)
SANTRAL_SECRET=

# --- Google STT (STREAMING = servis hesabi JSON gerekir, API anahtari YETMEZ) ---
# Servis hesabi json dosyasinin TAM yolu
GOOGLE_APPLICATION_CREDENTIALS=/opt/restaurant-santral-ai/google-stt.json
STT_LANGUAGE=tr-TR
# STT modeli. tr-TR icin 'latest_long' onerilir.
# DIKKAT: 'phone_call'/'video' enhanced modeller cogu dilde SADECE en-* destekli;
# tr-TR ile phone_call yazarsan STT hic sonuc dondurmez (AI seni duymaz).
STT_MODEL=latest_long

# --- Google TTS (REST + API anahtari — mevcut anahtar kullanilabilir) ---
GOOGLE_TTS_API_KEY=
# Erkek Turkce WaveNet ses (memory: iOS'ta cihaz sesi kotu, sunucu TTS tercih)
TTS_VOICE=tr-TR-Wavenet-E
TTS_SPEAKING_RATE=1.05

# --- Davranis ---
# BARGE_IN=1 (ONERILEN): TAM-DUPLEKS. Musteri HER AN konusabilir (karsilama ustune bile),
#   sesi ASLA dusmez, konusunca AI susar. 'Beni duymadi' sorununu bitirir.
# BARGE_IN=0: yari-dupleks (AI konusurken musteri sesi STT'ye gitmez -> ilk cumle dusebilir). ONERILMEZ.
BARGE_IN=1
# Cevapsiz sessizlik (ms) sonra "orada misiniz?" / kapat.
# Not: AI konusurken sayilmaz; bu sure AI SUSTUKTAN sonra baslar. 15sn dogal konusmada araya girmez.
SESSIZLIK_MS=15000
LOG_LEVEL=info

# --- Ses kaydi (ARI bridge recording -> Laravel) ---
# KAYIT_AKTIF=1: AI gorusmesi + aktarilan cagri AYRI AYRI kaydedilir, panele yuklenir.
KAYIT_AKTIF=1
# Asterisk'in ARI kayitlarini yazdigi klasor (wav dosyalari burada olusur).
# Kopru bu klasordeki dosyayi okuyup Laravel'e yukler. Asterisk kurulumuna gore degisebilir.
ASTERISK_RECORDING_DIR=/var/spool/asterisk/recording

# --- Terk edilen cagri kurtarma (otomatik geri arama) ---
# Gorusme yarida kalinca (siparis/rezervasyon tamamlanmadan) AI musteriyi geri arar.
# OUTBOUND (disari arama) SART. Varsayilan KAPALI; dial ayarlayip 1 yapinca acilir.
GERI_ARAMA=0
# Dial sablonu ({num} = cevrilecek numara). Trunk'iniza gore:
#   chan_sip:  SIP/trunkadi/{num}      pjsip:  PJSIP/{num}@trunkadi
GERI_ARAMA_DIAL=
# {num} = numaranin son 10 hanesinin basina bu ek: 0 (ulusal) / 90 / +90 / bos. Trunk'iniza gore.
GERI_ARAMA_PREFIX=0
# Giden aramada gorunecek numara (bos ise aranan numara). Ornegin restoranin DID'i.
GERI_ARAMA_CALLERID=
# Callee cevap suresi (sn) ve kuyruk yoklama araligi (sn).
GERI_ARAMA_TIMEOUT=30
GERI_ARAMA_POLL_SN=20

# --- Ofis ambiyansi (comfort noise, UCRETSIZ) ---
# AMBIYANS=1: cagri boyunca TTS ALTINDA kisik ofis sesi calar -> olu sessizlik gider,
# "insan cagri merkezi" hissi olusur. Ses motoru DEGISMEZ (ek maliyet yok).
AMBIYANS=1
# Seviye 0..0.5 (yuksek=on sesi bastirir). 0.08-0.15 arasi tavsiye.
AMBIYANS_SEVIYE=0.12
# Gercek ofis ugultusu icin ham s16le mono dosya (cfg sampleRate'inde, ulaw modunda 8000):
#   ffmpeg -i ofis-ambiyans.mp3 -ac 1 -ar 8000 -f s16le assets/ofis-ambiyans.sln
# Dosya yoksa sentetik yumusak oda tonu kullanilir (yine de calisir).
# AMBIYANS_DOSYA=/opt/restaurant-santral-ai/assets/ofis-ambiyans.sln
