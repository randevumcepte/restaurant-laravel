; =====================================================================
;  ResteOS AI Santral — Asterisk 16/17 dialplan ornegi
;  /etc/asterisk/extensions.conf icine uyarlayin (context adlarina dikkat)
; =====================================================================

; --- Gelen restoran hatti: cagriyi AI Santral (Stasis/ARI) uygulamasina ver ---
[gelen-restoran]
; Tek subeli:
exten => s,1,NoOp(AI Santral cagri geldi: ${CALLERID(num)})
 same => n,Answer()
 same => n,Stasis(restaurant-santral-ai)      ; kopru bu app adini dinler (ARI_APP ile AYNI olmali)
 same => n,Hangup()

; Coklu sube ornegi (sube_id'yi arg olarak gecir):
; exten => s,1,Stasis(restaurant-santral-ai,SUBE=3)

; --- AI "insana aktar" dediginde kopru cagriyi buraya geri verir ---
; ONEMLI: SANTRAL_HEDEF + SANTRAL_ZIL degiskenleri DIALPLAN'DE ASSIGN EDILMEZ.
;   Kopru (index.js) ARI setChannelVar ile bu degiskenleri PANELDEN okuyup kanala YAZAR,
;   sonra kanali buraya devreder (continueInDialplan). Yani buraya gelindiginde degiskenler DOLUDUR.
;   Yine de guvenlik icin bos ihtimaline karsi defansif yaziyoruz.
; HEDEFI DEGISTIRMEK ICIN ASTERISK'E DOKUNMA -> panel: /santral-ayar
[santral-aktar]
exten => s,1,NoOp(AI -> aktarma hedefi: ${SANTRAL_HEDEF})
 same => n,ExecIf($["${SANTRAL_HEDEF}"=""]?Hangup())              ; hedef bossa guvenli kapat
 same => n,Set(ZIL=${IF($["${SANTRAL_ZIL}"=""]?30:${SANTRAL_ZIL})})
 same => n,Dial(${SANTRAL_HEDEF},${ZIL})                          ; or. SIP/101 veya SIP/trunk/05xx (panelden)
 same => n,Hangup()

; --- (Opsiyonel) Kacan cagriyi AI'nin geri aramasi icin outbound ---
; ARI originate ile kullanilir; buraya duserse AI karsilar:
[santral-outbound]
exten => s,1,Answer()
 same => n,Stasis(restaurant-santral-ai,YON=outbound)
 same => n,Hangup()
