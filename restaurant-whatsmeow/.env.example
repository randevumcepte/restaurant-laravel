# whatsmeow bridge config — kopyala .env yap, degerleri doldur
PORT=3002
DB_DIR=./data

# Laravel'in bridge'i çağırırken kullandığı token (X-Service-Token header).
# Baileys bridge'inde de bunun ayarı vardı, ayni degeri buraya yaz.
SERVICE_TOKEN=

# Laravel webhook endpoint'i — bridge sonuclari/event'leri buraya POST eder.
# Mevcut Baileys bridge ile ayni adresi kullan, kontrat ayni.
WEBHOOK_URL=https://app.randevumcepte.com.tr/api/wa-webhook
WEBHOOK_SECRET=

# Cihaz fingerprint - linked devices'da bu sekilde gorunur
# (whatsmeow default'u literal "whatsmeow" — degistirildi)
DEVICE_OS=Chrome
DEVICE_PLATFORM=DESKTOP

# Anti-burst: ardisik mesaj arasi rastgele bekleme araligi (saniye)
SEND_DELAY_MIN=12
SEND_DELAY_MAX=30
